# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection (local via MongoDB Compass)
MONGO_URI=mongodb://127.0.0.1:27017/synexus_catalogue

# JWT secret - replace with a long random string in your local .env
JWT_SECRET=x7k9mQp2vR8tL4nW6yB3fH5jD1sA0cE
JWT_EXPIRES_IN=7d

# Cookie settings
COOKIE_NAME=catalogue_admin_token

# CORS - frontend origin allowed to call this API
